@@ -1,7 +1,13 @@
 import SwiftUI
 
 extension Date {
-  static func toTimerInterval(miliseconds: Double) -> ClosedRange<Self> {
-    now ... max(now, Date(timeIntervalSince1970: miliseconds / 1000))
+  // startMiliseconds 가 있으면 그 시각부터 끝 시각까지의 구간(진행바가 0에서 차오른다), 없으면 지금부터 끝까지
+  static func toTimerInterval(miliseconds: Double, startMiliseconds: Double? = nil) -> ClosedRange<Self> {
+    let end = Date(timeIntervalSince1970: miliseconds / 1000)
+    if let start = startMiliseconds {
+      let from = Date(timeIntervalSince1970: start / 1000)
+      return min(from, end) ... end
+    }
+    return now ... max(now, end)
   }
 }
